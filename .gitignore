# Local standalone dev environment (DB data, downloaded WP core, credentials)
/.localenv/

# WordPress core (not vendored — installed by environment setup, never committed)
/wordpress/
/wp-admin/
/wp-includes/
/wp-*.php
!/tools/wp-cli.phar

# WordPress content that is environment-specific or generated
wp-content/uploads/
wp-content/upgrade/
wp-content/cache/
wp-content/backup*/
wp-content/*.log

# Config / secrets — never commit real credentials
wp-config.php
.env
.env.*
!.env.example
*.local.json
secrets/

# Dependencies
node_modules/
vendor/

# Build output
dist/
build/
*.map

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-*

# Claude Code session runtime state (not project content)
.claude/scheduled_tasks.lock

# Backups / DB dumps (never commit real data)
*.sql
*.sql.gz
*.zip
backups/

# Logs
logs/
*.log
